+/* No hardware description: reaching firmware startup would be a test failure. */
+static void isp_test_privacy_block_precedes_firmware_start(struct kunit *test)
+{
+	struct apple_isp *isp = isp_test_alloc(test);
+
+	isp->dev = kunit_device_register(test, "apple-isp-privacy-test");
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, isp->dev);
+	isp->privacy_blocked = true;
+	KUNIT_EXPECT_EQ(test, apple_isp_start_streaming(isp), -EACCES);
+	KUNIT_EXPECT_FALSE(test, test_bit(ISP_STATE_STREAMING, &isp->state));
+}
