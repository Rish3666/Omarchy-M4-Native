+/* Writing a slot must preserve every payload word and adjacent ring slots. */
+static void isp_test_message_payload_write(struct kunit *test)
+{
+	struct isp_sm_test *t = isp_sm_test_alloc(test);
+	struct isp_message request = {
+		.arg0 = 0x5000000, .arg1 = 1, .arg2 = 2, .arg3 = 3,
+		.arg4 = 4, .arg5 = 5, .arg6 = 6, .arg7 = 7,
+	};
+	struct isp_message slots[3];
+	struct isp_message sentinel;
+
+	memset(&sentinel, 0xa5, sizeof(sentinel));
+	memset(slots, 0xa5, sizeof(slots));
+	t->chan->virt = slots;
+	chan_write_msg_index(t->isp, t->chan, &request, 1);
+	KUNIT_EXPECT_MEMEQ(test, &slots[1], &request, sizeof(request));
+	KUNIT_EXPECT_MEMEQ(test, &slots[0], &sentinel, sizeof(sentinel));
+	KUNIT_EXPECT_MEMEQ(test, &slots[2], &sentinel, sizeof(sentinel));
+}
+
