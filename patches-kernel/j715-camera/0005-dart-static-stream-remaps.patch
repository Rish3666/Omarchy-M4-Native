+// SPDX-License-Identifier: GPL-2.0-only
+/* Test static remaps without attaching an IOMMU or touching hardware. */
+#include <kunit/test.h>
+#include <linux/unaligned.h>
+
+static struct apple_dart *dart_remap_test_alloc(struct kunit *test)
+{
+	struct apple_dart *dart = kunit_kzalloc(test, sizeof(*dart), GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, dart);
+	dart->hw = &apple_dart_hw_t8110;
+	dart->num_streams = 16;
+	return dart;
+}
+
+static void dart_remap_rejects_invalid_pairs(struct kunit *test)
+{
+	struct apple_dart *dart = dart_remap_test_alloc(test);
+
+	KUNIT_EXPECT_EQ(test, apple_dart_add_remap(dart, 16, 0), -ERANGE);
+	KUNIT_EXPECT_EQ(test, apple_dart_add_remap(dart, 1, 16), -ERANGE);
+	KUNIT_EXPECT_EQ(test, apple_dart_add_remap(dart, 1, 1), -ERANGE);
+	KUNIT_ASSERT_EQ(test, apple_dart_add_remap(dart, 1, 0), 0);
+	KUNIT_EXPECT_EQ(test, apple_dart_add_remap(dart, 1, 0), -EINVAL);
+	KUNIT_ASSERT_EQ(test, apple_dart_add_remap(dart, 2, 1), 0);
+	KUNIT_EXPECT_EQ(test, apple_dart_validate_remaps(dart), -EINVAL);
+}
+
+static void dart_remap_rejects_locked_roots(struct kunit *test)
+{
+	struct apple_dart *dart = dart_remap_test_alloc(test);
+
+	dart->locked = true;
+	/* No new property preserves the existing locked-DART path. */
+	KUNIT_EXPECT_EQ(test, apple_dart_validate_remaps(dart), 0);
+	KUNIT_ASSERT_EQ(test, apple_dart_add_remap(dart, 1, 0), 0);
+	KUNIT_EXPECT_EQ(test, apple_dart_validate_remaps(dart), -EOPNOTSUPP);
+}
+
+static void dart_remap_programs_only_source_tcrs(struct kunit *test)
+{
+	static const u32 sources[] = { 1, 2, 3, 6, 7, 10, 11 };
+	struct apple_dart *dart = dart_remap_test_alloc(test);
+	u8 *bank = kunit_kmalloc(test, 0x4000, GFP_KERNEL);
+	u8 *expected = kunit_kmalloc(test, 0x4000, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_NULL(test, bank);
+	KUNIT_ASSERT_NOT_NULL(test, expected);
+	memset(bank, 0xa5, 0x4000);
+	memset(expected, 0xa5, 0x4000);
+	dart->regs = (__force void __iomem *)bank;
+	for (int i = 0; i < ARRAY_SIZE(sources); i++) {
+		KUNIT_ASSERT_EQ(test, apple_dart_add_remap(dart, sources[i], 0), 0);
+		put_unaligned_le32(DART_T8110_TCR_REMAP_EN,
+				   expected + DART_TCR(dart, sources[i]));
+	}
+	KUNIT_ASSERT_EQ(test, apple_dart_validate_remaps(dart), 0);
+	apple_dart_hw_apply_remaps(dart);
+	KUNIT_EXPECT_MEMEQ(test, bank, expected, 0x4000);
+}
+
+static struct kunit_case dart_remap_cases[] = {
+	KUNIT_CASE(dart_remap_rejects_invalid_pairs),
+	KUNIT_CASE(dart_remap_rejects_locked_roots),
+	KUNIT_CASE(dart_remap_programs_only_source_tcrs),
+	{}
+};
+
+static struct kunit_suite dart_remap_suite = {
+	.name = "apple-dart-static-remap",
+	.test_cases = dart_remap_cases,
+};
+
+kunit_test_suite(dart_remap_suite);
